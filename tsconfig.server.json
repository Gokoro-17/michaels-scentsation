{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "tsBuildInfoFile": "./node_modules/.cache/typescript/server.tsbuildinfo",
    "allowImportingTsExtensions": true,
    "types": ["node"]
  },
  "include": ["api", "server", "scripts", "tests"]
}
